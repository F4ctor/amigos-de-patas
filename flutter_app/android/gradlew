#!/bin/sh
set -e
VERSION=9.1.0
CACHE_DIR="$HOME/.gradle/ong-adocao-wrapper"
GRADLE_HOME="$CACHE_DIR/gradle-$VERSION"
ZIP_FILE="$CACHE_DIR/gradle-$VERSION-all.zip"
if [ ! -x "$GRADLE_HOME/bin/gradle" ]; then
  mkdir -p "$CACHE_DIR"
  if command -v curl >/dev/null 2>&1; then
    curl -L "https://services.gradle.org/distributions/gradle-$VERSION-all.zip" -o "$ZIP_FILE"
  else
    wget "https://services.gradle.org/distributions/gradle-$VERSION-all.zip" -O "$ZIP_FILE"
  fi
  unzip -o "$ZIP_FILE" -d "$CACHE_DIR"
fi
exec "$GRADLE_HOME/bin/gradle" "$@"
